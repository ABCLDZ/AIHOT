{
  "$comment": "个人选题雷达的10家媒体配置；代理通过本机环境配置。各源状态以后台记录为准。每源首次最多8条，正文不公开展示。",
  "sources": [
    {
      "id": "media-ap",
      "name": "美联社 · 商业",
      "kind": "web_list",
      "config": {
        "url": "https://apnews.com/hub/business",
        "parseMode": "html",
        "itemSelector": "a[href*=\"/article/\"]",
        "allowUrlPrefixes": [
          "https://apnews.com/article/"
        ],
        "_aihot": {
          "initialBackfillLimit": 8
        },
        "sortByPublishedAt": true
      },
      "tier": "T2",
      "first_party": false,
      "participation_mode": "editorial",
      "interval_minutes": 90,
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": false,
      "tags": [
        "媒体"
      ]
    },
    {
